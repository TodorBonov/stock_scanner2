# Reports — ignore all regenerated and private outputs.
# NOTE: git does not support inline (end-of-line) comments in .gitignore — the comment
# becomes part of the pattern. Keep comments on their own lines.
# regenerated each run
reports/scan/latest.json
# growing data file, not source code
reports/scan/history.jsonl
# regenerated each run
reports/scan/scan_*.txt
# regenerated each run
reports/scan/scan_summary_*.csv
# GPT outputs — regenerated and contain private position data
reports/ai/
# intermediate JSON, regenerated each run
reports/data/
# ticker diagnostics, regenerated each run
reports/problems_with_tickers.txt

